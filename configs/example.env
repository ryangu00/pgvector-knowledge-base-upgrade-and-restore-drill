# Source after replacing the required paths. No connection secret belongs here.
export PGBIN="${PGBIN:?set an absolute PostgreSQL binary directory}"
export RSYNC="${RSYNC:?set the absolute rsync binary}"
export LSOF="${LSOF:?set the absolute lsof binary}"
export PGDATA="$PWD/work/source"
export ARCHIVE_DIR="$PWD/work/archive"
export BACKUP_ROOT="$PWD/work/backups"
export DRILL_ROOT="$PWD/work/drills"
export RESULT="$PWD/work/restore-result.json"
export DBNAME=postgres
export PROD_PORT=55991
export PORT=55992
export DRILL_TABLE=pages
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
# Set CLEANUP_PROVEN=yes only after reconciling a restore of this chain.
# Optional: MIRROR, MIRROR_CLEANUP_CMD, ALERT_CMD; no shipping by default.
